{
	"schemaVersion": 1,
	"id": "stackmobs",
	"version": "${version}",

	"name": "Stack Mobs",
	"description": "Merges nearby identical mobs into stacked entities to improve server performance.",
	"authors": [
		"StackMobs Contributors"
	],
	"contact": {
		"sources": "https://github.com/your-username/stack-mobs"
	},

	"license": "MIT",
	"icon": "assets/stackmobs/icon.png",

	"environment": "*",

	"entrypoints": {
		"main": [
			"com.stackmobs.StackMobsMod"
		]
	},

	"mixins": [
		"stackmobs.mixins.json"
	],

	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
